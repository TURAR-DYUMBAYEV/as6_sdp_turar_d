MarketplaceInspectionService ..> CatalogStatisticsVisitor
class Application
class Main
class EventSimulation
Main ..> Application
Application ..> EventSimulation
Application ..> MarketplaceCatalog
Application ..> PriceUpdateSource
Application ..> StockUpdateSource
