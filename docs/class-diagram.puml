StockUpdateSource --> MarketplaceInspectionService : low stock
interface CatalogElement
abstract class CatalogContainer
abstract class Product
class MarketplaceCatalog
class ProductCategory
class PhysicalProduct
class DigitalProduct
class ServiceProduct
class SubscriptionProduct
class GiftCardProduct
CatalogElement <|.. CatalogContainer
CatalogElement <|.. Product
CatalogContainer <|-- MarketplaceCatalog
CatalogContainer <|-- ProductCategory
CatalogContainer o-- CatalogElement : children
Product <|-- PhysicalProduct
Product <|-- DigitalProduct
Product <|-- ServiceProduct
Product <|-- SubscriptionProduct
Product <|-- GiftCardProduct
interface "CatalogVisitor<R>" as CatalogVisitor
abstract class TraversingVisitor
CatalogVisitor <|.. TraversingVisitor
class TaxCalculationVisitor
class CatalogStatisticsVisitor
class ProductFilterVisitor
class XmlExportVisitor
class ShippingCostVisitor
class AvailableValueVisitor
TraversingVisitor <|-- TaxCalculationVisitor
TraversingVisitor <|-- CatalogStatisticsVisitor
TraversingVisitor <|-- ProductFilterVisitor
TraversingVisitor <|-- XmlExportVisitor
TraversingVisitor <|-- ShippingCostVisitor
TraversingVisitor <|-- AvailableValueVisitor
