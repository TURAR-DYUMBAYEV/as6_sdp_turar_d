@startuml
interface "Subject<T>" as Subject
interface "Observer<T>" as Observer
class EventSubject
class PriceUpdateSource
class StockUpdateSource
class MarketplaceAggregator
Subject <|.. EventSubject
EventSubject <|-- PriceUpdateSource
EventSubject <|-- StockUpdateSource
Observer <|.. MarketplaceAggregator
Subject <|.. MarketplaceAggregator
class WishlistNotifier
class PriceDropAlert
class InventoryAlertListener
class MarketplaceAnalyticsListener
class ProductCacheListener
class MarketplaceSummaryListener
class MarketplaceInspectionService
Observer <|.. WishlistNotifier
Observer <|.. PriceDropAlert
Observer <|.. InventoryAlertListener
Observer <|.. MarketplaceAnalyticsListener
Observer <|.. ProductCacheListener
Observer <|.. MarketplaceSummaryListener
Observer <|.. MarketplaceInspectionService
